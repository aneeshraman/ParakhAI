# Sarvam: OCR (Sarvam Vision), language detection and translation. https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Optional Sarvam settings
# SARVAM_TRANSLATE_MODEL=sarvam-translate:v1   # or mayura:v1 (11 languages, 1000 chars/request)
# SARVAM_OCR_MODEL=                            # leave empty for Sarvam's default Vision model
# SARVAM_OCR_TIMEOUT_SECONDS=600

# --- Final LLM: Gemma ---------------------------------------------------------
# Default: Google AI Studio. Free key, no card: https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
LLM_MODEL=gemma-4-31b-it        # or gemma-4-26b-a4b-it (faster MoE)
GEMINI_API_KEY=

# Alternative: OpenRouter's free Gemma (20 req/min, 50 req/day until $10 of credits)
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=google/gemma-4-31b-it:free
# LLM_API_KEY=

# Alternative: Gemma running locally in Ollama (no key, no limits; check `ollama list` for the tag)
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=gemma4

# LLM_MAX_TOKENS=8192
